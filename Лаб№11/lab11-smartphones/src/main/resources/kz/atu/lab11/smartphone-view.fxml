<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.atu.lab11.controller.SmartphoneController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="2">
        <Label text="Каталог смартфонов" styleClass="app-title"/>
        <Label text="Ищите по названию, фильтруйте по бренду, сортируйте по клику на заголовок столбца"
               styleClass="app-subtitle"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="panel">
        <Label text="Поиск:" styleClass="field-label"/>
        <TextField fx:id="txtSearch" promptText="Начните вводить название модели"
                   HBox.hgrow="ALWAYS"/>
        <Label text="Бренд:" styleClass="field-label"/>
        <ComboBox fx:id="cmbBrandFilter" prefWidth="170"/>
        <Button fx:id="btnResetFilters" text="Сбросить" styleClass="btn-secondary"
                onAction="#onResetFilters"/>
    </HBox>

    <TableView fx:id="tablePhones" VBox.vgrow="ALWAYS" minHeight="200">
        <columns>
            <TableColumn fx:id="colName" text="Модель" prefWidth="320"/>
            <TableColumn fx:id="colBrand" text="Бренд" prefWidth="200"/>
            <TableColumn fx:id="colPrice" text="Цена" prefWidth="200"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="24" alignment="CENTER_LEFT">
        <Label fx:id="lblCount" text="Найдено смартфонов: 0" styleClass="stat"/>
        <Label fx:id="lblAverage" text="Средняя цена в каталоге: 0" styleClass="stat"/>
    </HBox>

    <VBox spacing="10" styleClass="panel">
        <Label fx:id="lblFormTitle" text="Новый смартфон" styleClass="field-label"/>
        <GridPane hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="70"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Модель:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtName" promptText="Например: Galaxy S24"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Бренд:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtBrand" promptText="Например: Samsung"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Цена, ₸:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPrice" promptText="Например: 449000"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="lblStatus" text="" styleClass="hint" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="btnAdd" text="Добавить" styleClass="btn-primary" onAction="#onAdd"/>
            <Button fx:id="btnUpdate" text="Сохранить изменения" styleClass="btn-secondary" onAction="#onUpdate"/>
            <Button fx:id="btnDelete" text="Удалить" styleClass="btn-danger" onAction="#onDelete"/>
            <Button fx:id="btnClear" text="Очистить форму" styleClass="btn-secondary" onAction="#onClear"/>
        </HBox>
    </VBox>
</VBox>
